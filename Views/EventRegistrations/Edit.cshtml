@model EditEventRegistrationViewModel

@{
    ViewData["Title"] = "Edit registration";
    var tuitionEvent = Model.Event!;
}

<h1 class="h2">Edit event registration</h1>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5">@tuitionEvent.Title</h2>
        <p class="mb-1">
            <strong>Starts:</strong>
            @tuitionEvent.StartsAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
        </p>
        <p class="mb-1">
            <strong>Deadline:</strong>
            @(tuitionEvent.ApplicationDeadline?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Not specified")
        </p>
        <p class="mb-0"><strong>Audience:</strong> @tuitionEvent.RegistrationAudience</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="Id" type="hidden" />
        <input asp-for="EventId" type="hidden" />

        <div class="mb-3">
            <label asp-for="Message" class="form-label"></label>
            <textarea asp-for="Message" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save and submit for review</button>
        <a asp-action="MyRegistrations" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
