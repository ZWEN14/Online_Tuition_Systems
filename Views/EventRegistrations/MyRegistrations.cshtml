@model IReadOnlyList<EventRegistration>

@{
    ViewData["Title"] = "My registrations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">My event registrations</h1>
    <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary">Browse events</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have not registered for any events.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Starts</th>
                    <th>Status</th>
                    <th>Review note</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registration in Model)
                {
                    var eventHasNotStarted = registration.Event.StartsAt > DateTimeOffset.UtcNow;
                    var registrationIsOpen = registration.Event.Status == EventStatus.Published
                        && eventHasNotStarted
                        && (!registration.Event.ApplicationDeadline.HasValue
                            || registration.Event.ApplicationDeadline.Value >= DateTimeOffset.UtcNow);
                    var canEdit = registrationIsOpen
                        && registration.Status is (
                            EventRegistrationStatus.Pending
                            or EventRegistrationStatus.Rejected
                            or EventRegistrationStatus.Cancelled);
                    var canCancel = eventHasNotStarted
                        && registration.Status is (
                            EventRegistrationStatus.Pending
                            or EventRegistrationStatus.Approved);

                    <tr>
                        <td>
                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@registration.EventId"
                               class="btn btn-sm btn-outline-primary">
                                @registration.Event.Title
                            </a>
                        </td>
                        <td>@registration.Event.StartsAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge status-badge status-@registration.Status.ToString().ToLowerInvariant()">@registration.Status</span></td>
                        <td>@(registration.ReviewNote ?? "-")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (canEdit)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@registration.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                }

                                @if (canCancel)
                                {
                                    <form asp-action="Cancel" asp-route-id="@registration.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
