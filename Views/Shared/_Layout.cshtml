<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online_Tuition_Systems</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Online_Tuition_Systems.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-mark" aria-hidden="true">OT</span>
                    <span class="app-brand-copy">
                        <strong>Online Tuition</strong>
                        <small>Learning Portal</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav app-nav-links">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" asp-area="" asp-controller="Announcements" asp-action="Index">Announcements</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" asp-area="" asp-controller="Events" asp-action="Index">Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" asp-area="" asp-controller="EventProposals" asp-action="Index">Proposals</a>
                            </li>
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-nav-link" asp-area="" asp-controller="EventRegistrations" asp-action="Manage">Registrations</a>
                                </li>
                            }
                            else if (User.IsInRole(AppRoles.Student) || User.IsInRole(AppRoles.Tutor))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-nav-link" asp-area="" asp-controller="EventRegistrations" asp-action="MyRegistrations">My Registrations</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @await Component.InvokeAsync("NotificationBell")
                        }
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer app-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; 2026 Online Tuition Learning Portal</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
