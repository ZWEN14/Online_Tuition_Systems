@inject ApplicationDbContext db
@inject Online_Tuition_Systems.Services.NotificationFeedService notificationFeed
@{
    var currentUserIdValue = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var unreadNotificationCount = int.TryParse(currentUserIdValue, out var currentUserId)
        ? await notificationFeed.CountAsync(currentUserId, unreadOnly: true)
        : 0;
    var currentUser = int.TryParse(currentUserIdValue, out var headerUserId)
        ? db.Users.FirstOrDefault(u => u.Id == headerUserId)
        : null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Anywhere Edureach")</title>
    <script>
        try {
            if (window.sessionStorage.getItem("app-sidebar-collapsed") === "true") {
                document.documentElement.classList.add("shell-sidebar-precollapsed");
            }
        } catch {
            // Render the normal expanded sidebar when browser storage is unavailable.
        }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/mentor-mentee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-sidebar.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
        <div class="container py-2">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="@(User.Identity?.IsAuthenticated == true ? "Index" : "Welcome")">
                <span class="brand-mark">A</span>
                <span class="brand-muted">Anywhere Edureach</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="user-summary d-flex align-items-center gap-2 me-lg-2 text-decoration-none" asp-controller="Account" asp-action="UpdateProfile" title="Open profile">
                                @if (!string.IsNullOrWhiteSpace(currentUser?.PhotoPath))
                                {
                                    <img class="user-avatar user-avatar-image" src="@currentUser.PhotoPath" alt="@currentUser.Name profile photo" />
                                }
                                else
                                {
                                    <span class="user-avatar">@currentUser?.Name?.FirstOrDefault()</span>
                                }
                                <strong class="app-user-name">@User.Identity!.Name</strong>
                            </a>
                        </li>
                        <li class="nav-item">@await Component.InvokeAsync("NotificationBell")</li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="app-logout-button" title="Sign out of Anywhere Edureach">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4M14 8l4 4-4 4M18 12H9" />
                                    </svg>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index">Courses</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="ResetPassword">Reset Password</a></li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell sidebar-enhanced">
            <aside class="app-sidebar">
                <div class="shell-sidebar-controls">
                    <button type="button" class="shell-sidebar-toggle shell-sidebar-menu"
                            aria-label="Toggle Quick Access sidebar">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
                <button type="button" class="shell-sidebar-toggle shell-sidebar-arrow"
                        aria-label="Collapse Quick Access sidebar">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m14 6-6 6 6 6"></path>
                    </svg>
                </button>
                <div class="sidebar-heading">Quick access</div>
                @* Bootstrap Icons "book", MIT licensed: https://icons.getbootstrap.com/icons/book/ *@
                <a class="sidebar-link" asp-controller="Courses" asp-action="Index">
                    <span class="shell-nav-icon">
                        <svg class="shell-course-icon" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783"></path>
                        </svg>
                    </span>
                    Courses
                </a>
                <a class="sidebar-link" asp-controller="Announcements" asp-action="Index"><span>A</span> Announcements</a>
                <a class="sidebar-link" asp-controller="Events" asp-action="Index"><span>E</span> Events</a>
                @if (User.IsInRole("Student") || User.IsInRole("Tutor"))
                {
                    <a class="sidebar-link" asp-controller="EventRegistrations" asp-action="MyRegistrations"><span>R</span> Event registrations</a>
                }
                @if (User.IsInRole("Tutor") || User.IsInRole("Admin"))
                {
                    <a class="sidebar-link" asp-controller="EventProposals" asp-action="Index"><span>P</span> Event proposals</a>
                }
                @if (User.IsInRole("Student"))
                {
                    <a class="sidebar-link" asp-controller="StudentCourses" asp-action="Index"><span class="shell-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6.5h14v12H5z"></path><path d="M8 3.5h8M8 21h8"></path><path d="m10 10 4 2-4 2z"></path></svg></span> My courses</a>
                    <a class="sidebar-link" asp-controller="Billing" asp-action="Index"><span class="shell-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-2-1.3L14 21l-2-1.3L10 21l-2-1.3L6 21z"></path><path d="M9 8h6M9 12h6M9 16h3"></path></svg></span> Billing history</a>
                    <a class="sidebar-link" asp-controller="Subject" asp-action="Index"><span>＋</span> Find a subject</a>
                    <a class="sidebar-link" asp-controller="Tutor" asp-action="Index"><span>⌕</span> Find a tutor</a>
                    <a class="sidebar-link" asp-controller="Booking" asp-action="Index"><span>▣</span> My learning</a>
                }
                @if (User.IsInRole("Tutor"))
                {
                    <a class="sidebar-link" asp-controller="TutorCourses" asp-action="Index"><span class="shell-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6.5h14v12H5z"></path><path d="M8 3.5h8M8 21h8"></path><path d="m10 10 4 2-4 2z"></path></svg></span> My courses</a>
                    <a class="sidebar-link" asp-controller="TutorPromotions" asp-action="Index"><span>%</span> Promotions</a>
                    <a class="sidebar-link" asp-controller="TutorBilling" asp-action="Index"><span class="shell-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-2-1.3L14 21l-2-1.3L10 21l-2-1.3L6 21z"></path><path d="M9 8h6M9 12h6M9 16h3"></path></svg></span> Course earnings</a>
                    <a class="sidebar-link" asp-controller="Timeslot" asp-action="Index"><span>◷</span> Availability</a>
                    <a class="sidebar-link" asp-controller="Booking" asp-action="Index"><span>▣</span> Student requests</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="sidebar-link" asp-controller="AdminCourseCategories" asp-action="Index"><span>▦</span> Course categories</a>
                    <a class="sidebar-link" asp-controller="AdminCourses" asp-action="Index"><span>✓</span> Course reviews</a>
                    <a class="sidebar-link" asp-controller="AdminBilling" asp-action="Index"><span class="shell-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-2-1.3L14 21l-2-1.3L10 21l-2-1.3L6 21z"></path><path d="M9 8h6M9 12h6M9 16h3"></path></svg></span> Billing overview</a>
                    <a class="sidebar-link" asp-controller="Admin" asp-action="Index"><span>◎</span> User management</a>
                }
                @if (User.IsInRole("Student") || User.IsInRole("Tutor"))
                {
                    <a class="sidebar-link" asp-controller="Survey" asp-action="Index"><span>S</span> Surveys</a>
                    <a class="sidebar-link" asp-controller="Survey" asp-action="MyResponses"><span>R</span> My survey responses</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="sidebar-link" asp-controller="SurveyAdmin" asp-action="Index"><span>S</span> Survey management</a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Student") || User.IsInRole("Tutor"))
                {
                    <a class="sidebar-link" asp-controller="Complaints" asp-action="Index"><span>C</span> Complaints</a>
                }
                <a class="sidebar-link" asp-controller="Notifications" asp-action="Index">
                    <span>●</span> <span class="sidebar-link-label">Notifications</span>@if (unreadNotificationCount > 0)
                    {
                        <span class="notification-count" aria-label="@unreadNotificationCount unread notifications">@unreadNotificationCount</span>
                    }
                </a>
                <a class="sidebar-link" asp-controller="Account" asp-action="UpdateProfile"><span>◯</span> Profile settings</a>
            </aside>
            <main class="container app-main pb-5">
                @if (!(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() is ("Home" or "SurveyAdmin" or "Complaints")))
                {
                    @if (ViewContext.RouteData.Values["controller"]?.ToString() is "SurveyAdmin" or "Survey" or "Complaints" or "ComplaintCategories")
                    {
                        <a class="page-back mb-3" asp-controller="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ComplaintCategories" ? "Complaints" : ViewContext.RouteData.Values["controller"]?.ToString())" asp-action="Index"><span aria-hidden="true">&larr;</span> Back</a>
                    }
                    else
                    {
                    <button type="button" class="page-back mb-3" data-back-fallback="@Url.Action("Index", "Home")">
                        <span aria-hidden="true">←</span> Back
                    </button>
                    }
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @Html.Raw(TempData["Info"])
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="container app-main pb-5">
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @Html.Raw(TempData["Info"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app-sidebar.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
