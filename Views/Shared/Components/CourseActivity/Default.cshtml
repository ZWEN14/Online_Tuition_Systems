@model Online_Tuition_Systems.ViewModels.Courses.CourseActivityViewModel

<section class="mt-5" aria-labelledby="course-activity-heading">
    <h2 id="course-activity-heading" class="h4 mb-3">Related events and announcements</h2>
    @if (Model.UpcomingEvents.Count == 0 && Model.Announcements.Count == 0)
    {
        <p class="text-muted">There are no published updates for this course yet.</p>
    }
    else
    {
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Upcoming events</h3>
                        @if (Model.UpcomingEvents.Count == 0)
                        {
                            <p class="text-muted mb-0">No upcoming events.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var tuitionEvent in Model.UpcomingEvents)
                                {
                                    <li class="mb-2">
                                        <a asp-controller="Events" asp-action="Details" asp-route-id="@tuitionEvent.Id">@tuitionEvent.Title</a>
                                        <span class="d-block small text-muted">@tuitionEvent.StartsAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Announcements</h3>
                        @if (Model.Announcements.Count == 0)
                        {
                            <p class="text-muted mb-0">No announcements.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var announcement in Model.Announcements)
                                {
                                    <li class="mb-2">
                                        <a asp-controller="Announcements" asp-action="Details" asp-route-id="@announcement.Id">@announcement.Title</a>
                                        <span class="d-block small text-muted">@(announcement.PublishedAt?.ToLocalTime().ToString("dd MMM yyyy"))</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</section>
