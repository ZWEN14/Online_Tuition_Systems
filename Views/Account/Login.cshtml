@model LoginVM

@{
    ViewBag.Title = "Account | Login";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card form-card">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4"><span class="brand-mark mb-3"></span><h1 class="h2 mb-1">Welcome back</h1><p class="text-muted mb-0">Sign in to continue learning.</p></div>

                <form method="post" data-ajax="true">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autofocus>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control">
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input">
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="mb-3">
                        <div class="g-recaptcha" data-sitekey="@ViewBag.RecaptchaSiteKey" data-action="LOGIN"></div>
                        <span class="text-danger">@Html.ValidationMessage("Captcha")</span>
                    </div>

                    <button class="btn btn-primary w-100">Login</button>
                </form>

                <p class="mt-4 text-center small">
                    <a asp-controller="Account" asp-action="Register">Create an account</a> ·
                    <a asp-controller="Account" asp-action="ResetPassword">Forgot password?</a>
                </p>

                @section Scripts {
                    <script src="https://www.google.com/recaptcha/enterprise.js" async defer></script>
                }
            </div>
        </div>
    </div>
</div>
