@model ProfileUpdateVM

@{
    ViewBag.Title = "Account | Update Profile";
}

<div class="row g-3 profile-layout">
    <div class="col-lg-8">
        <div class="card form-card profile-form-card">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4"><span class="text-uppercase small fw-semibold text-primary">Account settings</span><h1 class="h2 mb-1">Your Profile</h1><p class="text-muted mb-0">Manage your identity and optional profile photo.</p></div>

                <form id="profileForm" method="post" asp-controller="Account" asp-action="UpdateProfile" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <section class="profile-media-panel mb-4" aria-labelledby="photoHeading">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 id="photoHeading" class="h5 mb-1">Profile photo</h2>
                                <p class="small text-muted mb-0">Use the full photo editor to crop and rotate your profile photo.</p>
                            </div>
                            <span class="badge text-bg-light">Optional</span>
                        </div>
                        <div class="profile-photo-editor">
                            <div class="profile-photo-preview" id="photoPreview">
                                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                                {
                                    <img src="@Model.PhotoPath" alt="Profile photo" />
                                }
                                else
                                {
                                    <span>@Model.Name?.FirstOrDefault()</span>
                                }
                                <canvas id="photoCanvas" class="d-none" width="320" height="320" aria-label="Processed profile photo preview"></canvas>
                            </div>
                            <div class="profile-media-controls flex-grow-1">
                                <label asp-for="Photo" class="form-label fw-semibold">Choose an image</label>
                                <input asp-for="Photo" class="form-control" accept="image/png,image/jpeg,image/webp" id="photoInput">
                                <div class="form-text">Images are processed in your browser and uploaded as a square JPG, up to 5 MB.</div>
                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="PhotoEditor">Open full photo editor</a>
                                </div>
                                <div id="photoStatus" class="form-text mt-2" role="status"></div>
                            </div>
                        </div>
                    </section>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="form-control-plaintext fw-semibold">@Model.Email</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               type="tel"
                               autocomplete="tel"
                               placeholder="e.g. 012-345 6789">
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="submit" class="btn btn-primary">Update profile</button>
                        <a class="btn btn-outline-secondary" asp-action="UpdatePassword">Update password</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
