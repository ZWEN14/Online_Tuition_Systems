@model UpdatePasswordVM

@{
    ViewBag.Title = "Account | Update Password";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card form-card">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4"><span class="text-uppercase small fw-semibold text-primary">Account security</span><h1 class="h2 mb-1">Update Password</h1><p class="text-muted mb-0">Complete both verification steps to protect your account.</p></div>

                @if (!Model.CurrentVerified)
                {
                    <div class="password-step active mb-4"><span class="step-number">1</span><div><strong>Verify current password</strong><div class="small text-muted">Confirm that you own this account.</div></div></div>
                    <form method="post" asp-action="VerifyPassword" data-ajax="true">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Current" class="form-label"></label>
                            <input asp-for="Current" class="form-control" autofocus>
                            <span asp-validation-for="Current" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Verify and continue</button>
                    </form>
                }
                else
                {
                    <div class="password-step active mb-4"><span class="step-number">2</span><div><strong>Choose a new password</strong><div class="small text-muted">A one-time code has been sent to your email.</div></div></div>
                    <form method="post" asp-action="UpdatePassword" data-ajax="true">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        @if (Model.VerificationCodeSent)
                        {
                            <div class="alert alert-info">Enter the six-digit code sent to your email to confirm this change.</div>
                            <div class="mb-3">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" autofocus>
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                        }
                        <div class="mb-3">
                            <label asp-for="New" class="form-label"></label>
                            <input asp-for="New" class="form-control" autofocus>
                            <span asp-validation-for="New" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Confirm" class="form-label"></label>
                            <input asp-for="Confirm" class="form-control">
                            <span asp-validation-for="Confirm" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Update password</button>
                    </form>
                }
            </div>
        </div>
    </div>
