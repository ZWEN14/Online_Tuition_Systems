@model ResetPasswordVM

@{
    ViewBag.Title = "Account | Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card form-card">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4"><span class="text-uppercase small fw-semibold text-primary">Account recovery</span><h1 class="h2 mb-1">Reset Password</h1><p class="text-muted mb-0">Request a one-time email link, then choose a new password.</p></div>

                @if (Model.RequestSent)
                {
                    <div class="alert alert-success" role="status">
                        Check your email for the password reset link. The link expires in 15 minutes.
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (Model.VerificationSent || !string.IsNullOrWhiteSpace(Model.Token))
                    {
                        <div class="alert alert-info">Use the secure link from your email to choose a new password. The link expires after 15 minutes.</div>
                        <input type="hidden" asp-for="Token" />
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" readonly>
                        </div>
                        <div class="mb-3">
                            <label asp-for="New" class="form-label"></label>
                            <input asp-for="New" class="form-control" autocomplete="new-password">
                            <span asp-validation-for="New" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Confirm" class="form-label"></label>
                            <input asp-for="Confirm" class="form-control" autocomplete="new-password">
                            <span asp-validation-for="Confirm" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Set new password</button>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autofocus>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Email reset link</button>
                    }
                </form>
            </div>
        </div>
    </div>
