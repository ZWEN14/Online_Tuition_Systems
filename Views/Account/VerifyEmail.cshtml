@model VerifyEmailVM

@{
    ViewBag.Title = "Account | Verify Email";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card form-card">
            <div class="card-body p-4 p-md-5">
                <span class="text-uppercase small fw-semibold text-primary">Account verification</span>
                <h1 class="h2 mb-1">Verify your email</h1>
                <p class="text-muted mb-4">Enter the six-digit code sent to your email address.</p>

                <form method="post" data-ajax="true">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="Email" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control form-control-lg text-center" inputmode="numeric" autocomplete="one-time-code" autofocus />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary w-100">Verify email</button>
                </form>
            </div>
        </div>
    </div>
</div>
