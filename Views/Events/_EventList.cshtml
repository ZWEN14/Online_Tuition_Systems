@model EventIndexViewModel

<p class="small text-muted">@Model.TotalCount event(s) found.</p>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No events match the current filters.</div>
}
else
{
    <div class="row g-3">
        @foreach (var tuitionEvent in Model.Items)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2">
                            <h2 class="h5">@tuitionEvent.Title</h2>
                            <span class="badge text-bg-secondary align-self-start">@tuitionEvent.Status</span>
                        </div>
                        <p class="text-muted mb-2">@tuitionEvent.StartsAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                        <p class="mb-0">@tuitionEvent.Mode &middot; @tuitionEvent.RegistrationAudience</p>
                    </div>
                    <div class="card-footer bg-white text-end">
                        <a asp-action="Details" asp-route-id="@tuitionEvent.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Event pages" class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-muted">Page @Model.Page of @Model.TotalPages</span>
        <ul class="pagination pagination-sm mb-0">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : null)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-mode="@Model.Mode"
                       asp-route-audience="@Model.Audience"
                       asp-route-status="@Model.Status"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@pageNumber"
                       data-ajax-page="@pageNumber">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
