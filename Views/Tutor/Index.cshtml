@model TutorIndexVM

@{
    ViewBag.Title = Model.SelectedSubject != null ? $"Tutor | {Model.SelectedSubject.Name}" : "Tutor | Index";
}

<div class="page-header">
    <span class="text-uppercase small fw-semibold text-primary">Tutor directory</span>
    <h1 class="mb-1">@(Model.SelectedSubject != null ? $"{Model.SelectedSubject.Name} Tutors" : "All Tutors")</h1>
    <p class="mb-0">Find the right tutor and explore their available sessions.</p>
</div>

<div class="row g-3">
    @if (!Model.Tutors.Any())
    {
        <div class="empty-state">No tutors found for this subject yet.</div>
    }
    @foreach (var tutor in Model.Tutors)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title">@tutor.Name</h5>
                    <p class="text-warning mb-1">★ @(tutor.Tutor?.Rating.ToString("0.00") ?? "N/A") <span class="text-muted">rating</span></p>
                    <p class="text-muted mb-3">
                        Handles: @(tutor.TutorSubjects.Any() ? string.Join(", ", tutor.TutorSubjects.Select(ts => ts.Subject!.Name)) : "None listed")
                    </p>
                    <a class="btn btn-dark mt-auto" asp-controller="Tutor" asp-action="Show" asp-route-id="@tutor.Id" asp-route-subjectId="@(Model.SelectedSubject?.Id)">
                        View Profile &amp; Timetable
                    </a>
                </div>
            </div>
        </div>
    }
</div>
