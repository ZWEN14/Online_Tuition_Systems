@model Online_Tuition_Systems.ViewModels.ComplaintManageViewModel
@{ViewData["Title"]="Manage Complaint";}<h2>Manage Complaint #@Model.Id</h2><form method="post"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select><span asp-validation-for="CategoryId" class="text-danger"></span></div><div class="mb-3"><label asp-for="AssignedTutorId" class="form-label"></label><select asp-for="AssignedTutorId" asp-items="ViewBag.AssignedTutorId" class="form-select"><option value="">Not assigned</option></select><span asp-validation-for="AssignedTutorId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<Online_Tuition_Systems.Models.ComplaintStatus>()" class="form-select"></select></div><div class="mb-3"><label asp-for="ResolutionNotes" class="form-label"></label><textarea asp-for="ResolutionNotes" class="form-control" rows="6"></textarea><span asp-validation-for="ResolutionNotes" class="text-danger"></span></div><button class="btn btn-primary">Save Changes</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
