@model List<SubjectListVM>
@{
    ViewBag.Title = "Subjects";
}
<div class="page-header">
    <span class="text-uppercase small fw-semibold text-primary">Learning catalogue</span>
    <h1 class="mb-1">Subject Overview</h1>
    <p class="mb-0">Choose a subject first, then select a tutor and available session.</p>
</div>

<div class="row g-4">

    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column p-4">
                    <h4>@item.Subject.Name</h4>
                    <p class="text-muted">@(!string.IsNullOrWhiteSpace(item.Subject.Description) ? item.Subject.Description : "Learn this subject with an available tutor.")</p>
                    <div class="bg-primary-subtle text-primary-emphasis rounded p-2">From <strong>RM @item.Subject.BaseCost.ToString("0.00")/hour</strong></div>
                    <p class="mt-3">@item.TutorCount @(item.TutorCount == 1 ? "tutor" : "tutors") available</p>
                    <div class="d-flex gap-2 mt-auto">
                        <a class="btn btn-outline-dark flex-fill" asp-controller="Tutor" asp-action="Index" asp-route-subjectId="@item.Subject.Id">View Tutors</a>
                        <a class="btn btn-dark flex-fill" asp-controller="Booking" asp-action="Create" asp-route-subjectId="@item.Subject.Id">Book Now</a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12"><div class="empty-state">No subjects are available for booking yet.</div></div>
    }

</div>
