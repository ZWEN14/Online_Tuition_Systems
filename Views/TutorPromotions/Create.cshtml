@model Online_Tuition_Systems.ViewModels.Billing.PromotionFormViewModel
@{
    ViewData["Title"] = "Create Promotion";
}

<h1 class="h3">Create Promotion</h1>
<p class="text-muted">Create a discount for one of your paid published courses.</p>

<form asp-action="Create" method="post" class="card card-body mt-4">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PromotionScripts" />
}
