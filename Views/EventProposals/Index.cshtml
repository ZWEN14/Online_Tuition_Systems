@model IReadOnlyList<EventProposal>

@{
    ViewData["Title"] = "Event proposals";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<section class="module-header module-header-violet mb-4">
    <div>
        <span class="module-kicker">IDEAS &amp; REVIEW</span>
        <h1 class="h2 mb-1">Event proposals</h1>
        <p class="mb-0">
            @(User.IsInRole(AppRoles.Admin) ? "All submitted proposals." : "Only proposals submitted by you.")
        </p>
    </div>
    @if (User.IsInRole(AppRoles.Student) || User.IsInRole(AppRoles.Tutor))
    {
        <a asp-action="Create" class="btn btn-primary">Submit proposal</a>
    }
</section>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No event proposals were found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <th>Proposed by</th>
                    }
                    <th>Suggested audience</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proposal in Model)
                {
                    var proposalStatusClass = proposal.Status switch
                    {
                        EventProposalStatus.Approved => "status-published",
                        EventProposalStatus.Rejected => "status-cancelled",
                        _ => "status-draft"
                    };

                    <tr>
                        <td>@proposal.Title</td>
                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <td>@proposal.ProposedByUserId</td>
                        }
                        <td>@proposal.ProposedRegistrationAudience</td>
                        <td><span class="badge status-badge @proposalStatusClass">@proposal.Status</span></td>
                        <td>@proposal.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@proposal.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
