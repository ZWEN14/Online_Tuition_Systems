@model EventProposalFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="Id" type="hidden" />

<div class="alert alert-info border-0 mb-4">
    Share the event idea and why it would benefit learners. The Admin will decide
    the final mode, venue, registration deadline, capacity and online meeting details.
</div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CourseId" class="form-label"></label>
        <input asp-for="CourseId" class="form-control" />
        <div class="form-text">Optional until the Course module is connected.</div>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PreferredStartsAt" class="form-label"></label>
        <input asp-for="PreferredStartsAt"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               type="datetime-local"
               class="form-control" />
        <span asp-validation-for="PreferredStartsAt" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PreferredEndsAt" class="form-label"></label>
        <input asp-for="PreferredEndsAt"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               type="datetime-local"
               class="form-control" />
        <span asp-validation-for="PreferredEndsAt" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ProposedRegistrationAudience" class="form-label"></label>
        <select asp-for="ProposedRegistrationAudience"
                asp-items="Html.GetEnumSelectList<RegistrationAudience>()"
                class="form-select"></select>
        <span asp-validation-for="ProposedRegistrationAudience" class="text-danger"></span>
    </div>
</div>
