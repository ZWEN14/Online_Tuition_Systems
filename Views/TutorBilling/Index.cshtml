@model Online_Tuition_Systems.ViewModels.Billing.TutorBillingReportViewModel
@{
    ViewData["Title"] = "Course Earnings";
    var printMode = ViewData["PrintMode"] as bool? == true;
    var rangeLabel = Model.Filter.HasRange
        ? $"{(Model.Filter.FromDateMyt?.ToString("dd MMM yyyy") ?? "Beginning")} to {(Model.Filter.ToDateMyt?.ToString("dd MMM yyyy") ?? "Today")} MYT"
        : "All dates";
}

<div class="report-page-heading mb-4">
    <div>
        <h1 class="h3 mb-1">Course Earnings</h1>
        <p class="text-muted mb-0">Enrollment and revenue from your own courses.</p>
    </div>
    <div class="report-heading-actions print-hidden">
        <button class="btn btn-outline-secondary" type="button"
                data-bs-toggle="collapse" data-bs-target="#tutorEarningsFilter"
                aria-expanded="@(Model.Filter.HasRange ? "true" : "false")"
                aria-controls="tutorEarningsFilter">
            Filter
            @if (Model.Filter.HasRange)
            {
                <span class="badge text-bg-primary ms-1">Active</span>
            }
        </button>
        <a asp-action="Print"
           asp-route-FromDateMyt="@Model.Filter.FromDateMyt?.ToString("yyyy-MM-dd")"
           asp-route-ToDateMyt="@Model.Filter.ToDateMyt?.ToString("yyyy-MM-dd")"
           target="_blank" rel="noopener"
           class="btn btn-outline-primary">
            Print earnings report
        </a>
    </div>
</div>

<div class="print-report-header">
    <strong>Anywhere Edureach</strong>
    <span>Tutor Course Earnings report · @rangeLabel</span>
</div>

@if (!printMode)
{
    <div class="collapse @(Model.Filter.HasRange ? "show" : null) print-hidden"
         id="tutorEarningsFilter">
        <form asp-action="Index" method="get" class="card card-body report-filter mb-4"
              data-billing-report-filter>
            <partial name="_BillingReportFilter" model="Model.Filter" />
        </form>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Your courses</div>
            <div class="h3 mb-0">@Model.TotalCourses</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Active enrollments</div>
            <div class="h3 mb-0">@Model.ActiveEnrollments</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Pending payments</div>
            <div class="h3 mb-0">@Model.PendingPayments</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Gross sales</div>
            <div class="h3 mb-0">RM @Model.GrossSales.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card h-100 border-success"><div class="card-body">
            <div class="text-muted small">Your net earnings</div>
            <div class="h3 text-success mb-0">RM @Model.TutorEarnings.ToString("N2")</div>
        </div></div>
    </div>
</div>

@if (Model.Courses.Count > 0)
{
    <section class="row g-3 align-items-start mb-4" aria-labelledby="courseAnalyticsHeading">
        <div class="col-12">
            <h2 id="courseAnalyticsHeading" class="h4 mb-0">Course analytics</h2>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h3 class="h6 mb-0">Course portfolio</h3>
                        <button type="button" class="analytics-info-button"
                                data-bs-toggle="tooltip"
                                data-bs-title="Your courses grouped by their current workflow status."
                                aria-label="About Course portfolio">i</button>
                    </div>
                    <div class="course-status-summary">
                        @foreach (var status in Model.CourseStatuses)
                        {
                            <div class="course-status-stat">
                                <strong>@status.Count</strong>
                                <span>@status.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h3 class="h6 mb-0">Top courses by net earnings</h3>
                        <button type="button" class="analytics-info-button"
                                data-bs-toggle="tooltip"
                                data-bs-title="Up to five courses ranked by your recorded net earnings after platform fees."
                                aria-label="About top courses">i</button>
                    </div>
                    <div class="course-analytics-list">
                        @{ var courseRank = 0; }
                        @foreach (var course in Model.LeadingCourses)
                        {
                            courseRank++;
                            var earningsAriaText = $"RM {course.TutorEarnings:N2} net earnings";
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-1">
                                    <div class="d-flex gap-2 min-w-0">
                                        <span class="course-rank" aria-label="Rank @courseRank">@courseRank</span>
                                        <span class="text-truncate">@course.Title</span>
                                    </div>
                                    <strong class="text-nowrap">RM @course.TutorEarnings.ToString("N2")</strong>
                                </div>
                                <div class="course-analytics-track" role="progressbar"
                                     aria-label="Net earnings for @course.Title"
                                     aria-valuenow="@course.EarningsBarPercentage"
                                     aria-valuemin="0" aria-valuemax="100"
                                     aria-valuetext="@earningsAriaText">
                                    <div class="course-analytics-fill course-analytics-fill-success"
                                         style="width: @course.EarningsBarPercentage%"></div>
                                </div>
                                <div class="small text-muted mt-1 ms-4">
                                    @course.ActiveEnrollments active enrollment(s)
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<div class="alert alert-light border">
    Successful sales use the stored 15% platform commission snapshot.
    Platform fees recorded: <strong>RM @Model.PlatformFees.ToString("N2")</strong>.
</div>

@if (Model.TotalCourses == 0)
{
    <div class="alert alert-info">Create a course to begin receiving enrollments.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-end gap-3 mb-2">
        <h2 class="h4 mb-0">Course breakdown</h2>
        @if (!Model.IsFullReport)
        {
            <span class="small text-muted">
                Page @Model.CoursePage of @Model.TotalCoursePages
            </span>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Active</th>
                    <th>Pending</th>
                    <th>Paid sales</th>
                    <th>Gross</th>
                    <th>Platform fee</th>
                    <th>Net earnings</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td>
                            <div>
                                <a asp-action="Course" asp-route-id="@course.CourseId"
                                   asp-route-FromDateMyt="@Model.Filter.FromDateMyt?.ToString("yyyy-MM-dd")"
                                   asp-route-ToDateMyt="@Model.Filter.ToDateMyt?.ToString("yyyy-MM-dd")"
                                   class="fw-semibold">@course.Title</a>
                            </div>
                            <small class="text-muted">@course.Code</small>
                        </td>
                        <td><span class="badge text-bg-secondary">@course.Status</span></td>
                        <td>@course.ActiveEnrollments</td>
                        <td>@course.PendingPayments</td>
                        <td>@course.SuccessfulSales</td>
                        <td>RM @course.GrossSales.ToString("N2")</td>
                        <td>RM @course.PlatformFees.ToString("N2")</td>
                        <td class="fw-semibold">RM @course.TutorEarnings.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalCoursePages > 1)
    {
        <nav class="mt-3 print-hidden" aria-label="Course earnings pages">
            <ul class="pagination pagination-sm justify-content-center">
                @for (var pageNumber = 1; pageNumber <= Model.TotalCoursePages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CoursePage ? "active" : null)">
                        <a asp-action="Index" asp-route-coursePage="@pageNumber"
                           asp-route-FromDateMyt="@Model.Filter.FromDateMyt?.ToString("yyyy-MM-dd")"
                           asp-route-ToDateMyt="@Model.Filter.ToDateMyt?.ToString("yyyy-MM-dd")"
                           class="page-link"
                           aria-current="@(pageNumber == Model.CoursePage ? "page" : null)">
                            @pageNumber
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/billing-report-filter.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.analytics-info-button').forEach(element => {
            bootstrap.Tooltip.getOrCreateInstance(element);
        });
        @if (printMode)
        {
            <text>window.addEventListener('load', () => window.print());</text>
        }
    </script>
}
