@model Online_Tuition_Systems.ViewModels.Enrollments.StudentCoursesViewModel
@{
    ViewData["Title"] = "My Courses";
}

<div class="mb-4">
    <h1 class="mb-1">My Courses</h1>
    <p class="text-muted mb-0">Open active courses and review enrollments awaiting payment.</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["InfoMessage"] is string infoMessage)
{
    <div class="alert alert-info">@infoMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (Model.Courses.Count == 0)
{
    <div class="alert alert-info">
        You have not enrolled in a course yet.
        <a asp-controller="Courses" asp-action="Index" class="alert-link">Explore courses</a>.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(course.ThumbnailPath))
                    {
                        <img src="@course.ThumbnailPath" class="card-img-top"
                             alt="Thumbnail for @course.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="small text-muted mb-1">@course.Code</div>
                        <h2 class="h5">@course.Title</h2>
                        <p class="text-muted">Tutor: @course.TutorName</p>
                        <div class="d-flex gap-2 flex-wrap mb-3">
                            <span class="badge text-bg-secondary">@course.EnrollmentStatus</span>
                            @if (course.CourseStatus == CourseStatus.Archived)
                            {
                                <span class="badge text-bg-light">Archived</span>
                            }
                            else if (course.CourseStatus == CourseStatus.Suspended)
                            {
                                <span class="badge text-bg-danger">Suspended</span>
                            }
                        </div>
                        <div class="mt-auto">
                            @if (course.HasAccess)
                            {
                                <a asp-action="Access" asp-route-id="@course.CourseId"
                                   class="btn btn-primary w-100">Open course</a>
                            }
                            else if (course.EnrollmentStatus == EnrollmentStatus.PendingPayment)
                            {
                                <a asp-controller="Billing" asp-action="Checkout"
                                   asp-route-enrollmentId="@course.EnrollmentId"
                                   class="btn btn-outline-primary w-100">Continue to payment</a>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-100" disabled>
                                    Course unavailable
                                </button>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
