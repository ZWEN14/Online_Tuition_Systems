@model IEnumerable<Online_Tuition_Systems.Models.Survey>
@{ ViewData["Title"] = "Available Surveys"; var answered = ((IEnumerable<int>)ViewBag.AnsweredIds).ToHashSet(); var eligible = (HashSet<int>)ViewBag.EligibleIds; }
<div class="d-flex justify-content-between align-items-center"><h2>Available Surveys</h2><a asp-action="MyResponses" class="btn btn-outline-primary">My Responses</a></div>
<div class="row g-3 mt-1">
@foreach (var survey in Model)
{
    var submitted = answered.Contains(survey.Id);
    var canTake = eligible.Contains(survey.Id);
    <div class="col-md-6"><div class="card h-100"><div class="card-body d-flex flex-column">
        <h5>@survey.Title</h5><p>@survey.Description</p>
        <div class="text-muted mb-3">@(survey.Course?.Title ?? "General survey") · @survey.Questions.Count question(s) @if (survey.ExpiresAt.HasValue) { <span> · Closes @survey.ExpiresAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span> }</div>
        <div class="mt-auto">
        @if (submitted) { <span class="badge bg-success">Submitted</span> }
        else if (!canTake) { <span class="badge bg-warning text-dark">Enrollment required</span><div class="small text-muted mt-1">This survey is visible, but only enrolled users can submit it.</div> }
        else if (!survey.Questions.Any()) { <span class="badge bg-secondary">No questions yet</span> }
        else { <a asp-action="Take" asp-route-id="@survey.Id" class="btn btn-primary">Take Survey</a> }
        </div>
    </div></div></div>
}
@if (!Model.Any()) { <p class="text-muted">No surveys are currently available.</p> }
</div>
