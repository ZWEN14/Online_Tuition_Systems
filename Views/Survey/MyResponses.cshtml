@model IEnumerable<Online_Tuition_Systems.Models.SurveyResponse>
@{ ViewData["Title"]="My Survey Responses"; }
<h2>My Survey Responses</h2><table class="table table-striped"><thead><tr><th>Survey</th><th>Submitted</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Survey?.Title</td><td>@r.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="ResponseDetails" asp-route-id="@r.Id">View answers</a></td></tr>}</tbody></table>
