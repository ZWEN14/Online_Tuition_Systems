@model Online_Tuition_Systems.ViewModels.SurveySubmissionViewModel
@using Online_Tuition_Systems.Models
@{ViewData["Title"]="Take Survey";}
<h2>@Model.SurveyTitle</h2><p>@Model.SurveyDescription</p>
<div class="progress mb-3" style="height:8px"><div class="progress-bar" id="survey-progress"></div></div>
<form method="post" enctype="multipart/form-data" id="section-survey-form"><input type="hidden" asp-for="SurveyId"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
@for(var s=0;s<Model.Sections.Count;s++)
{
var surveySection=Model.Sections[s];
<section class="survey-section" data-section-id="@surveySection.Id" data-order="@surveySection.DisplayOrder" data-action="@((int)surveySection.AfterSectionAction)" data-destination="@surveySection.NextSectionId" hidden>
<div class="mb-3"><div class="text-muted">Section @(s+1) of @Model.Sections.Count</div><h3>@surveySection.Title</h3><p>@surveySection.Description</p></div>
@foreach(var questionId in surveySection.QuestionIds)
{
var i=Model.Answers.FindIndex(x=>x.QuestionId==questionId);var answer=Model.Answers[i];
<div class="card mb-3 survey-question" data-required="@answer.IsRequired.ToString().ToLowerInvariant()"><div class="card-body"><input type="hidden" asp-for="Answers[i].QuestionId"/><label class="form-label fw-bold">@answer.QuestionText @if(answer.IsRequired){<span class="text-danger">*</span>}</label>
@if(answer.Type==SurveyQuestionType.Text){<textarea asp-for="Answers[i].Value" class="form-control answer-control" rows="4" maxlength="2000"></textarea>}
else if(answer.Type==SurveyQuestionType.FileUpload){<input asp-for="Answers[i].Files" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.txt" class="form-control answer-control"/><div class="form-text">Up to 5 files, 5 MB each. JPG, PNG, WebP, PDF, or TXT. Total uploads: 25 MB per submission.</div>}
else if(answer.Type==SurveyQuestionType.Rating){<select asp-for="Answers[i].Value" class="form-select answer-control"><option value="">Select rating</option>@for(var rating=1;rating<=5;rating++){<option value="@rating">@rating</option>}</select>}
else if(answer.Type==SurveyQuestionType.YesNo){<select asp-for="Answers[i].Value" class="form-select answer-control"><option value="">Select answer</option><option value="Yes">Yes</option><option value="No">No</option></select>}
else if(answer.Type==SurveyQuestionType.Dropdown){<select asp-for="Answers[i].Value" class="form-select answer-control routing-answer"><option value="">Select option</option>@foreach(var option in answer.Options){<option value="@option.Id" data-action="@((int)option.BranchAction)" data-destination="@option.DestinationSectionId">@option.Text</option>}</select>}
else if(answer.Type==SurveyQuestionType.MultipleChoice){<div class="routing-answer">@foreach(var option in answer.Options){var optionId=$"answer_{i}_{option.Id}";<div class="form-check"><input class="form-check-input answer-control" type="radio" name="Answers[@i].Value" value="@option.Id" id="@optionId" checked="@(answer.Value==option.Id.ToString())" data-action="@((int)option.BranchAction)" data-destination="@option.DestinationSectionId"/><label class="form-check-label" for="@optionId">@option.Text</label></div>}</div>}
else{<div class="checkbox-answer">@foreach(var option in answer.Options){var optionId=$"answer_{i}_{option.Id}";<div class="form-check"><input class="form-check-input answer-control" type="checkbox" name="Answers[@i].SelectedValues" value="@option.Id" id="@optionId" checked="@answer.SelectedValues.Contains(option.Id.ToString())"/><label class="form-check-label" for="@optionId">@option.Text</label></div>}</div>}
</div></div>
}
<div class="d-flex justify-content-between"><button type="button" class="btn btn-outline-secondary back-section">Back</button><button type="button" class="btn btn-primary next-section">Next</button><button type="submit" class="btn btn-success submit-survey">Submit</button></div>
</section>
}
</form>
@section Scripts{
<partial name="_ValidationScriptsPartial"/>
<script src="~/js/survey-take.js" asp-append-version="true"></script>}
