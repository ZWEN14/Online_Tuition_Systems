@model IReadOnlyList<Online_Tuition_Systems.ViewModels.Courses.CourseListItemViewModel>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No published courses match your search.</div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(course.ThumbnailPath))
                    {
                        <img src="@course.ThumbnailPath"
                             class="card-img-top"
                             style="height: 190px; object-fit: cover"
                             alt="Thumbnail for @course.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="small text-muted mb-2">@course.CategoryName · @course.Code</div>
                        <h2 class="h5 card-title">@course.Title</h2>
                        <p class="card-text text-muted flex-grow-1">
                            @(course.ShortDescription ?? "View the course details to learn more.")
                        </p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="small">Tutor: @course.TutorName</span>
                            <strong>@(course.Price == 0 ? "Free" : $"RM {course.Price:N2}")</strong>
                        </div>
                        <a asp-action="Details"
                           asp-route-slug="@course.Slug"
                           class="btn btn-outline-primary">View course</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
