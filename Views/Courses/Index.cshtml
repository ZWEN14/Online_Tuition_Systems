@model Online_Tuition_Systems.ViewModels.Courses.CourseCatalogViewModel
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="mb-1">Explore courses</h1>
        <p class="text-muted mb-0">Learn online with our approved tutors.</p>
    </div>
    <span class="text-muted">@Model.TotalCourses course(s)</span>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label asp-for="Search" class="form-label">Search</label>
            <input asp-for="Search" class="form-control" placeholder="Course title or code" />
        </div>
        <div class="col-md-4">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CourseCategoryId">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </div>
</form>

<partial name="_CourseCards" model="Model.Courses" />

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Course pages">
        <ul class="pagination justify-content-center">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : null)">
                    <a class="page-link"
                       asp-route-page="@pageNumber"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
