@model IEnumerable<Online_Tuition_Systems.Models.Survey>
@{ ViewData["Title"]="Survey Management"; }
<div class="d-flex justify-content-between"><h2>Survey Management</h2><a asp-action="Create" class="btn btn-primary">Create Survey</a></div><div class="table-responsive mt-3"><table class="table table-hover"><thead><tr><th>Title</th><th>Course</th><th>Questions</th><th>Responses</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td><span class="d-block text-truncate" style="max-width: 220px;" title="@s.Title">@s.Title</span></td><td><span class="d-block text-truncate" style="max-width: 150px;" title="@(s.Course?.Title??"General")">@(s.Course?.Title??"General")</span></td><td>@s.Questions.Count</td><td>@s.Responses.Count</td><td>@(s.IsActive?"Active":"Inactive")</td><td><div class="d-flex flex-nowrap align-items-center gap-2 text-nowrap"><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Manage</a> <a asp-action="Responses" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View Responses</a> <a asp-action="DownloadCsv" asp-route-id="@s.Id" class="btn btn-sm btn-outline-success">Download CSV</a> <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="m-0 flex-shrink-0"><button class="btn btn-sm btn-outline-secondary">@(s.IsActive?"Deactivate":"Activate")</button></form></div></td></tr>}</tbody></table></div>
