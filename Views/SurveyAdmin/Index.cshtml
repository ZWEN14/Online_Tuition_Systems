@model IEnumerable<Online_Tuition_Systems.Models.Survey>
@{ ViewData["Title"]="Survey Management"; }
<div class="d-flex justify-content-between"><h2>Survey Management</h2><a asp-action="Create" class="btn btn-primary">Create Survey</a></div><table class="table table-hover mt-3"><thead><tr><th>Title</th><th>Course</th><th>Questions</th><th>Responses</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Title</td><td>@(s.Course?.Title??"General")</td><td>@s.Questions.Count</td><td>@s.Responses.Count</td><td>@(s.IsActive?"Active":"Inactive")</td><td><div class="d-flex flex-wrap gap-2"><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Manage</a> <a asp-action="Responses" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View Responses</a> <a asp-action="DownloadCsv" asp-route-id="@s.Id" class="btn btn-sm btn-outline-success">Download CSV</a> <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(s.IsActive?"Deactivate":"Activate")</button></form></div></td></tr>}</tbody></table>
