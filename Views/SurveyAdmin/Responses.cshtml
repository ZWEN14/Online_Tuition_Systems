@model IEnumerable<Online_Tuition_Systems.Models.SurveyResponse>
@{var survey=(Online_Tuition_Systems.Models.Survey)ViewBag.Survey;ViewData["Title"]="Survey Responses";}<h2>Responses: @survey.Title</h2><table class="table table-striped"><thead><tr><th>User</th><th>Role</th><th>Submitted</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.User?.Name</td><td>@r.User?.Role</td><td>@r.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="ResponseDetails" asp-route-id="@r.Id">View Answers</a></td></tr>}</tbody></table><a asp-action="Index" class="btn btn-secondary">Back to index</a>
