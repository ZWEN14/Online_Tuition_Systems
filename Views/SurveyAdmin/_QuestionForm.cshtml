@model Online_Tuition_Systems.ViewModels.QuestionEditViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="SurveyId"/>
<div class="mb-3"><label asp-for="Text" class="form-label"></label><textarea asp-for="Text" class="form-control" rows="2"></textarea><span asp-validation-for="Text" class="text-danger"></span></div>
<div class="row g-3 mb-3"><div class="col-md-4"><label asp-for="SectionId" class="form-label"></label><select asp-for="SectionId" asp-items="ViewBag.SectionId" class="form-select"></select><span asp-validation-for="SectionId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<Online_Tuition_Systems.Models.SurveyQuestionType>()" class="form-select" id="question-type"></select></div><div class="col-md-2"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control"/></div><div class="col-md-2 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsRequired" class="form-check-input"/><label asp-for="IsRequired" class="form-check-label"></label></div></div></div>
<div class="mb-3" id="question-options"><label asp-for="OptionsText" class="form-label">Options (one per line)</label><textarea asp-for="OptionsText" class="form-control" rows="5"></textarea><span asp-validation-for="OptionsText" class="text-danger"></span></div>
<button class="btn btn-primary">Save Question</button> <a asp-action="Details" asp-route-id="@Model.SurveyId" class="btn btn-secondary">Cancel</a>
<script>(()=>{const type=document.getElementById('question-type'),group=document.getElementById('question-options'),options=document.getElementById('OptionsText');const refresh=()=>{const show=['3','5','6'].includes(type.value);group.hidden=!show;options.required=show;};type.addEventListener('change',refresh);refresh();})();</script>
