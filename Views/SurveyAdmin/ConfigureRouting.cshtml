@model Online_Tuition_Systems.ViewModels.SurveyRoutingViewModel
@using Online_Tuition_Systems.Models
@{ViewData["Title"]="Configure Section Routing";}
<h2>Configure Section Routing</h2><p><strong>@Model.SectionTitle:</strong> @Model.QuestionText</p><div class="alert alert-info">Choose where each answer goes. Only later sections are available, preventing backward loops.</div>
<form method="post"><input type="hidden" asp-for="QuestionId"/><input type="hidden" asp-for="SurveyId"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
@for(var i=0;i<Model.Options.Count;i++){<div class="card mb-3"><div class="card-body"><input type="hidden" asp-for="Options[i].OptionId"/><input type="hidden" asp-for="Options[i].OptionText"/><h5>@Model.Options[i].OptionText</h5><div class="row g-3"><div class="col-md-6"><label asp-for="Options[i].Action" class="form-label"></label><select asp-for="Options[i].Action" asp-items="Html.GetEnumSelectList<SurveyBranchAction>()" class="form-select route-action"></select></div><div class="col-md-6 destination-group"><label asp-for="Options[i].DestinationSectionId" class="form-label">Destination Section</label><select asp-for="Options[i].DestinationSectionId" asp-items="ViewBag.DestinationSectionId" class="form-select"><option value="">Select section</option></select></div></div></div></div>}
<button class="btn btn-primary">Save Routing</button> <a asp-action="Details" asp-route-id="@Model.SurveyId" class="btn btn-secondary">Cancel</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(()=>{const refresh=()=>document.querySelectorAll('.route-action').forEach(select=>{const group=select.closest('.row').querySelector('.destination-group');group.hidden=select.value!=='2';group.querySelector('select').required=select.value==='2';});document.addEventListener('change',e=>{if(e.target.matches('.route-action'))refresh();});refresh();})();</script>}
