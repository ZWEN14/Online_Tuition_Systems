@model IReadOnlyList<Online_Tuition_Systems.ViewModels.Courses.TutorCourseListItemViewModel>
@{
    ViewData["Title"] = "My Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">My Courses</h1>
        <p class="text-muted mb-0">Manage your tuition course listings.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create course</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have not created any courses yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Course</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td>@course.Code</td>
                        <td>@course.Title</td>
                        <td>@course.CategoryName</td>
                        <td>@(course.Price == 0 ? "Free" : $"RM {course.Price:N2}")</td>
                        <td><span class="badge text-bg-secondary">@course.Status</span></td>
                        <td>@course.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                @if (course.CanEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@course.CourseId"
                                       class="btn btn-sm btn-outline-secondary">Edit</a>
                                }
                                @if (course.CanSubmit)
                                {
                                    <form asp-action="Submit" asp-route-id="@course.CourseId" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            Submit for review
                                        </button>
                                    </form>
                                }
                                @if (course.CanArchive)
                                {
                                    <form asp-action="Archive" asp-route-id="@course.CourseId" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Archive</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(course.RejectionReason))
                    {
                        <tr class="table-warning">
                            <td colspan="7">
                                <strong>Rejection reason:</strong> @course.RejectionReason
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
