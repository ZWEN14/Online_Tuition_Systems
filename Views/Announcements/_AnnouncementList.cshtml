@model AnnouncementIndexViewModel

<p class="small text-muted">@Model.TotalCount announcement(s) found.</p>

@if (Model.Items.Count == 0)
{
    <div class="card border-0 bg-light">
        <div class="card-body py-5 text-center">
            <h2 class="h5">No announcements found</h2>
            <p class="text-muted mb-0">Try changing the search or filter values.</p>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Audience</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var announcement in Model.Items)
                {
                    var statusClass = announcement.Status switch
                    {
                        AnnouncementStatus.Published => "status-published",
                        AnnouncementStatus.Archived => "status-archived",
                        _ => "status-draft"
                    };

                    var priorityClass = announcement.Priority switch
                    {
                        AnnouncementPriority.Urgent => "priority-high",
                        AnnouncementPriority.Important => "priority-normal",
                        _ => "priority-low"
                    };

                    <tr>
                        <td>
                            <div class="fw-semibold">@announcement.Title</div>
                            <div class="small text-muted text-truncate announcement-preview">@announcement.Content</div>
                        </td>
                        <td>@announcement.Audience</td>
                        <td><span class="badge priority-badge @priorityClass">@announcement.Priority</span></td>
                        <td><span class="badge status-badge @statusClass">@announcement.Status</span></td>
                        <td>@announcement.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            @if (User.IsInRole(AppRoles.Admin)
                                && announcement.Status != AnnouncementStatus.Archived)
                            {
                                <a asp-action="Edit" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Announcement pages" class="d-flex justify-content-between align-items-center">
        <span class="small text-muted">Page @Model.Page of @Model.TotalPages</span>
        <ul class="pagination pagination-sm mb-0">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : null)"
                    aria-current="@(pageNumber == Model.Page ? "page" : null)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-audience="@Model.Audience"
                       asp-route-priority="@Model.Priority"
                       asp-route-status="@Model.Status"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@pageNumber"
                       data-ajax-page="@pageNumber">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
