@model Announcement

@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-start mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
            <span class="badge priority-badge priority-@Model.Priority.ToString().ToLowerInvariant()">@Model.Priority priority</span>
        </div>
        <h1 class="h2 mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">Audience: @Model.Audience</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="announcement-content">@Model.Content</div>
    </div>
</div>

<dl class="row border rounded p-3 bg-light">
    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd>

    <dt class="col-sm-3">Created by</dt>
    <dd class="col-sm-9">@(Model.CreatedByUserId ?? "System")</dd>

    <dt class="col-sm-3">Last updated</dt>
    <dd class="col-sm-9">@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd>

    <dt class="col-sm-3">Published</dt>
    <dd class="col-sm-9">@(Model.PublishedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Not published")</dd>

    <dt class="col-sm-3">Expires</dt>
    <dd class="col-sm-9">@(Model.ExpiresAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "No expiry")</dd>
</dl>

<div class="d-flex flex-wrap gap-2 mt-4">
    @if (User.IsInRole(AppRoles.Admin)
        && Model.Status != AnnouncementStatus.Archived)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
    }

    @if (User.IsInRole(AppRoles.Admin)
        && Model.Status == AnnouncementStatus.Draft)
    {
        <form asp-action="Publish" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Publish</button>
        </form>
    }

    @if (User.IsInRole(AppRoles.Admin)
        && Model.Status == AnnouncementStatus.Published)
    {
        <form asp-action="Archive" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-warning">Archive</button>
        </form>
    }
</div>
