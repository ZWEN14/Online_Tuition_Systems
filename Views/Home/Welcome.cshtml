@{
    ViewBag.Title = "Anywhere Edureach | Welcome";
}

<div class="welcome-page">
    <section class="welcome-hero">
        <div class="welcome-copy">
            <span class="welcome-kicker"><span class="brand-mark">A</span> Anywhere Edureach</span>
            <h1>Learn without limits.</h1>
            <p class="welcome-lead">Book tuition sessions with qualified tutors, anytime, anywhere.</p>
            <p class="welcome-description">Find the right support for your goals, choose a time that works for you, and learn with confidence.</p>
            <div class="welcome-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Get started <span aria-hidden="true">→</span></a>
                <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
            </div>
            <div class="welcome-benefits">
                <span>✓ Qualified tutors</span>
                <span>✓ Flexible scheduling</span>
                <span>✓ Learning made personal</span>
            </div>
        </div>
        <div class="welcome-visual" aria-hidden="true">
            <div class="welcome-orbit orbit-one"></div>
            <div class="welcome-orbit orbit-two"></div>
            <div class="welcome-visual-card"><span class="fs-1">✦</span><strong>Your next lesson starts here.</strong><small>Learn at your pace</small></div>
        </div>
    </section>
</div>
