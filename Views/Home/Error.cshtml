@{
    ViewBag.Title = "Error";
}

<div class="card border-0 text-center py-5 px-3">
    <div class="display-4 text-danger mb-3">!</div>
    <h1 class="text-danger">An error occurred</h1>
    <p class="text-muted">Something went wrong while processing your request. Please try again.</p>
    <a class="btn btn-primary mx-auto" asp-controller="Home" asp-action="Index">Back to Dashboard</a>
</div>
